APP_NAME=Whitfield WMS
DATABASE_PATH=./data/wms_client_ready.sqlite3
ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+\.onrender\.com$
JWT_SECRET=change-me-before-production
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_NAME=Organization Admin
